# .env.example — Copy to .env and fill in your actual values.
# NEVER commit .env with real secrets.

# MySQL connection settings
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_PORT=3306
DB_NAME=canteen_db
DB_POOL_SIZE=5

# Flask session signing key — generate a strong random key for production
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-this-to-a-random-secret-key

# Flask environment
FLASK_ENV=development
FLASK_DEBUG=1
